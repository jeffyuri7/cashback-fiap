diff --git a/clean/src/Cashback.Clean.Infrastructure/Repositories/FeatureFlagRepository.cs b/clean/src/Cashback.Clean.Infrastructure/Repositories/FeatureFlagRepository.cs
new file mode 100644
index 0000000..13930f4
